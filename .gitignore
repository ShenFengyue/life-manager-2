# ============================================================
#  私人数据：绝对不能进 Git、绝不能上传
#  应用运行产生的全部数据都在 data/ 下：
#    数据库（含 WAL/SHM）、日记 diary.md、备份、JSON 导出、日志、界面配置
# ============================================================
data/

# 只要你在这个仓库里提交，上面的规则会一直生效
# （tests/test_repo_hygiene.py 会检查这一条，防止被人误删）

# ------------------------------------------------------------
#  虚拟环境与 Python 缓存
# ------------------------------------------------------------
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# ------------------------------------------------------------
#  开发过程产物（预览截图、测试临时目录、构建临时目录）
# ------------------------------------------------------------
.preview/
.test_tmp/
.build_tmp/

# 日志（正式日志在 data/logs 里，这里再兜一层）
*.log

# Windows 快捷方式（里面写着本机的绝对路径，换机器没意义）
*.lnk
